{
  "$schema": "titonium.settings/v2",
  "schemaVersion": 2,
  "locale": "vi",
  "appearance": {
    "themeId": "titonium-neutral",
    "mode": "dark",
    "density": "comfortable",
    "overrides": {}
  },
  "accessibility": {
    "reducedMotion": false
  },
  "modules": {
    "launcher": {
      "username": "Cole",
      "avatarIcon": "rocket_launch",
      "defaultCategory": "media",
      "resultLimit": 42,
      "columns": 7,
      "pageTransition": "slide-scale",
      "transitionDuration": 280,
      "showSubtitles": false,
      "searchAutoFocus": false
    },
    "sentinel": {
      "enabled": true
    }
  }
}
