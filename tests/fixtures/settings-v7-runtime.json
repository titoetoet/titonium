{
  "$schema": "titonium.settings/v7",
  "schemaVersion": 7,
  "locale": "vi",
  "appearance": { "mode": "dark" },
  "accessibility": { "reducedMotion": false },
  "applications": { "hiddenIds": [] },
  "modules": {
    "spotlight": { "pageTransition": "slide-fade", "transitionDuration": 220 },
    "bar": { "workspaceCount": 8, "autoHide": true },
    "dock": {
      "visibilityMode": "always-visible",
      "pinnedIds": ["org.mozilla.firefox.desktop"]
    },
    "notifications": { "toastsEnabled": false, "toastDuration": 9000 },
    "clock": { "use24Hour": true },
    "audio": { "allowAmplification": false }
  }
}
