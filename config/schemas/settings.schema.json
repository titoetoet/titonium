{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titonium.settings/v2",
  "type": "object",
  "required": ["schemaVersion", "locale", "appearance", "accessibility", "modules"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "locale": { "enum": ["vi", "en"] },
    "appearance": {
      "type": "object",
      "required": ["themeId", "mode", "density", "overrides"],
      "additionalProperties": false,
      "properties": {
        "themeId": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["dark", "light"] },
        "density": { "enum": ["compact", "comfortable"] },
        "overrides": { "type": "object" }
      }
    },
    "accessibility": {
      "type": "object",
      "required": ["reducedMotion"],
      "additionalProperties": false,
      "properties": {
        "reducedMotion": { "type": "boolean" }
      }
    },
    "modules": {
      "type": "object",
      "properties": {
        "frame": {
          "type": "object",
          "required": ["enabled", "thickness", "cornerRadius", "opacity"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "thickness": { "type": "integer", "minimum": 1, "maximum": 8 },
            "cornerRadius": { "type": "integer", "minimum": 0, "maximum": 32 },
            "opacity": { "type": "number", "minimum": 0.3, "maximum": 1.0 }
          }
        },
        "audio": {
          "type": "object",
          "required": ["volumeStep", "maxVolume", "visualizerEnabled", "visualizerStyle", "visualizerBars"],
          "additionalProperties": false,
          "properties": {
            "volumeStep": { "type": "integer", "minimum": 1, "maximum": 20 },
            "maxVolume": { "type": "integer", "minimum": 50, "maximum": 150 },
            "visualizerEnabled": { "type": "boolean" },
            "visualizerStyle": { "enum": ["bars", "wave", "dots"] },
            "visualizerBars": { "type": "integer", "minimum": 16, "maximum": 64 }
          }
        },
        "launcher": {
          "type": "object",
          "required": ["defaultCategory", "resultLimit", "columns", "showSubtitles", "searchAutoFocus"],
          "additionalProperties": false,
          "properties": {
            "defaultCategory": { "enum": ["all", "internet", "development", "media", "system"] },
            "resultLimit": { "type": "integer", "minimum": 6, "maximum": 48 },
            "columns": { "type": "integer", "minimum": 4, "maximum": 8 },
            "showSubtitles": { "type": "boolean" },
            "searchAutoFocus": { "type": "boolean" }
          }
        },
        "clock": {
          "type": "object",
          "required": ["use24Hour", "showLunar"],
          "additionalProperties": false,
          "properties": {
            "use24Hour": { "type": "boolean" },
            "showLunar": { "type": "boolean" }
          }
        }
      }
    }
  }
}
