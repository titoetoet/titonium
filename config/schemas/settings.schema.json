      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "dark",
            "light",
            "system"
          ]
        },
        "themeId": {
          "enum": [
            "glassmorphism",
            "material",
            "liquid-glass",
            "modern-flat",
            "neumorphism",
            "neutral",
            "glass",
            "soft",
            "graphite"
          ]
        },
        "themeOverrides": {
          "type": "object",
          "propertyNames": {
            "enum": ["glassmorphism", "material", "liquid-glass", "modern-flat", "neumorphism",
              "neutral", "glass", "soft", "graphite"]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "light": {"$ref": "#/$defs/appearanceOverride"},
              "dark": {"$ref": "#/$defs/appearanceOverride"}
            }
          },
          "properties": {
            "neutral": {
              "type": "object",
              "additionalProperties": false,
