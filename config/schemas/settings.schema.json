                    },
                    "radiusScale": {
                      "type": "number",
                      "minimum": 0.75,
                      "maximum": 1.25
                    },
                    "motionScale": {
                      "type": "number",
                      "minimum": 0.5,
                      "maximum": 1.5
                    }
                  }
                },
                "dark": {
                  "type": "object",
