{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titonium.settings/v2",
  "type": "object",
  "required": ["schemaVersion", "locale", "appearance", "accessibility", "modules"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "locale": { "enum": ["vi", "en"] },
    "appearance": {
      "type": "object",
      "required": ["themeId", "mode", "density", "overrides"],
      "additionalProperties": false,
      "properties": {
        "themeId": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["dark", "light"] },
        "density": { "enum": ["compact", "comfortable"] },
        "overrides": { "type": "object" }
      }
    },
    "accessibility": {
      "type": "object",
      "required": ["reducedMotion"],
      "additionalProperties": false,
      "properties": {
        "reducedMotion": { "type": "boolean" }
      }
    },
    "modules": { "type": "object" }
  }
}
