                      "maximum": 1.5
                    }
                  }
                }
              }
            }
          }
        },
        "wallpaper": {
          "type": "object",
          "required": [
            "policy",
            "customPath"
          ],
          "additionalProperties": false,
          "properties": {
            "policy": {
              "enum": [
                "keep",
                "theme",
                "custom"
              ]
            },
            "customPath": {
              "type": "string"
            }
          }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "required": [
        "reducedMotion"
      ],
      "additionalProperties": false,
      "properties": {
        "reducedMotion": {
          "type": "boolean"
        }
      }
    },
    "applications": {
      "type": "object",
      "required": [
        "hiddenIds"
      ],
      "additionalProperties": false,
      "properties": {
        "hiddenIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "modules": {
      "type": "object",
      "required": [
        "spotlight",
        "bar",
        "dock",
        "notifications",
        "clock",
        "audio"
      ],
      "additionalProperties": false,
      "properties": {
        "spotlight": {
          "type": "object",
          "required": [
            "pageTransition",
            "transitionDuration"
          ],
          "additionalProperties": false,
          "properties": {
            "pageTransition": {
              "enum": [
                "slide-fade",
                "fade",
                "none"
              ]
            },
            "transitionDuration": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            }
          }
        },
        "bar": {
          "type": "object",
          "required": [
            "workspaceCount",
            "autoHide",
            "mascotEnabled",
            "style"
          ],
          "additionalProperties": false,
          "properties": {
            "workspaceCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "autoHide": {
              "type": "boolean"
            },
            "mascotEnabled": {
              "type": "boolean"
            },
            "height": {
              "type": "integer",
              "minimum": 40,
              "maximum": 64
            },
            "mascot": {
              "type": "string",
              "enum": [
                "pig",
                "pig-lavender",
                "dog"
              ]
            },
            "style": {
              "enum": [
                "connected",
                "classic"
              ]
            }
          }
        },
        "dock": {
          "type": "object",
          "required": [
            "visibilityMode",
            "pinnedIds"
          ],
          "additionalProperties": false,
          "properties": {
            "style": {
              "enum": [
                "follow-topbar",
                "connected",
                "classic"
              ]
            },
            "visibilityMode": {
              "enum": [
                "auto-hide",
                "always-visible",
                "reserve-space",
                "hidden"
              ]
            },
            "pinnedIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "notifications": {
          "type": "object",
          "required": [
            "toastsEnabled",
            "toastDuration",
            "policyMode",
            "allowCriticalOnIsland",
            "keepCriticalUnread",
            "applicationOverrides"
          ],
          "additionalProperties": false,
          "properties": {
            "toastsEnabled": {
              "type": "boolean"
            },
            "toastDuration": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 10000
            },
            "policyMode": {
              "enum": [
                "automatic",
                "custom"
              ]
            },
            "allowCriticalOnIsland": {
              "type": "boolean"
            },
            "keepCriticalUnread": {
              "type": "boolean"
            },
            "applicationOverrides": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^(?!\\s*$)(?!\\s*(?:__proto__|prototype|constructor)\\s*$).+$"
              },
              "additionalProperties": {
                "enum": [
                  "follow",
                  "quiet",
                  "normal",
                  "critical",
                  "block"
                ]
              }
            }
          }
        },
        "clock": {
          "type": "object",
          "required": [
            "use24Hour"
          ],
          "additionalProperties": false,
          "properties": {
            "use24Hour": {
              "type": "boolean"
            }
          }
        },
        "audio": {
          "type": "object",
          "required": [
            "allowAmplification"
          ],
          "additionalProperties": false,
          "properties": {
            "allowAmplification": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
