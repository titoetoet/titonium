{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titonium.settings/v8",
  "$defs": {
    "appearanceOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accent": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "backgroundOpacity": {"type": "number", "minimum": 0.85, "maximum": 1},
        "borderStrength": {"type": "number", "minimum": 0, "maximum": 1},
        "shadowStrength": {"type": "number", "minimum": 0, "maximum": 1},
        "sheenStrength": {"type": "number", "minimum": 0, "maximum": 1},
        "radiusScale": {"type": "number", "minimum": 0.75, "maximum": 1.25},
        "motionScale": {"type": "number", "minimum": 0.5, "maximum": 1.5}
      }
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "locale",
    "appearance",
    "accessibility",
    "applications",
    "modules"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "titonium.settings/v8"
    },
    "schemaVersion": {
      "const": 8
    },
    "locale": {
      "enum": [
        "vi",
        "en"
      ]
    },
    "appearance": {
