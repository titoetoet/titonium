                  "properties": {
                    "accent": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "backgroundOpacity": {
                      "type": "number",
                      "minimum": 0.85,
                      "maximum": 1
                    },
                    "borderStrength": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "shadowStrength": {
                      "type": "number",
                      "minimum": 0,
