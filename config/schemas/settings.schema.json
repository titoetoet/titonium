{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titonium.settings/v5",
  "type": "object",
  "required": ["$schema", "schemaVersion", "locale", "appearance", "accessibility", "applications", "modules"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "titonium.settings/v5" },
    "schemaVersion": { "const": 5 },
    "locale": { "enum": ["vi", "en"] },
    "appearance": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": { "mode": { "enum": ["dark", "light"] } }
    },
    "accessibility": {
      "type": "object",
      "required": ["reducedMotion"],
      "additionalProperties": false,
      "properties": { "reducedMotion": { "type": "boolean" } }
    },
    "applications": {
      "type": "object",
      "required": ["hiddenIds"],
      "additionalProperties": false,
      "properties": {
        "hiddenIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "modules": {
      "type": "object",
      "required": ["spotlight", "clock"],
      "additionalProperties": false,
      "properties": {
        "spotlight": {
          "type": "object",
          "required": ["pageTransition", "transitionDuration"],
          "additionalProperties": false,
          "properties": {
            "pageTransition": { "enum": ["none", "fade", "slide-fade"] },
            "transitionDuration": { "type": "integer", "minimum": 0, "maximum": 500 }
          }
        },
        "clock": {
          "type": "object",
          "required": ["use24Hour"],
          "additionalProperties": false,
          "properties": { "use24Hour": { "type": "boolean" } }
        }
      }
    }
  }
}
