{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titonium.settings/v7",
  "type": "object",
  "required": ["$schema", "schemaVersion", "locale", "appearance", "accessibility", "applications", "modules"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "titonium.settings/v7" },
    "schemaVersion": { "const": 7 },
    "locale": { "enum": ["vi", "en"] },
    "appearance": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": { "mode": { "enum": ["dark", "light"] } }
    },
    "accessibility": {
      "type": "object",
      "required": ["reducedMotion"],
      "additionalProperties": false,
      "properties": { "reducedMotion": { "type": "boolean" } }
    },
    "applications": {
      "type": "object",
      "required": ["hiddenIds"],
      "additionalProperties": false,
      "properties": {
        "hiddenIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "modules": {
      "type": "object",
      "required": ["spotlight", "bar", "dock", "notifications", "clock", "audio"],
      "additionalProperties": false,
      "properties": {
        "spotlight": {
          "type": "object",
          "required": ["pageTransition", "transitionDuration"],
          "additionalProperties": false,
          "properties": {
            "pageTransition": { "enum": ["slide-fade", "fade", "none"] },
            "transitionDuration": { "type": "integer", "minimum": 0, "maximum": 500 }
          }
        },
        "bar": {
          "type": "object",
          "required": ["workspaceCount", "autoHide", "mascotEnabled", "style"],
          "additionalProperties": false,
          "properties": {
            "workspaceCount": { "type": "integer", "minimum": 1, "maximum": 8 },
            "autoHide": { "type": "boolean" },
            "mascotEnabled": { "type": "boolean" },
            "style": { "enum": ["connected", "classic"] }
          }
        },
        "dock": {
          "type": "object",
          "required": ["visibilityMode", "pinnedIds"],
          "additionalProperties": false,
          "properties": {
            "visibilityMode": { "enum": ["auto-hide", "always-visible", "reserve-space", "hidden"] },
            "pinnedIds": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "notifications": {
          "type": "object",
          "required": ["toastsEnabled", "toastDuration"],
          "additionalProperties": false,
          "properties": {
            "toastsEnabled": { "type": "boolean" },
            "toastDuration": { "type": "integer", "minimum": 2000, "maximum": 10000 }
          }
        },
        "clock": {
          "type": "object",
          "required": ["use24Hour"],
          "additionalProperties": false,
          "properties": { "use24Hour": { "type": "boolean" } }
        },
        "audio": {
          "type": "object",
          "required": ["allowAmplification"],
          "additionalProperties": false,
          "properties": { "allowAmplification": { "type": "boolean" } }
        }
      }
    }
  }
}
