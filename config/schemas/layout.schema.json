{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titonium.layout/v1",
  "type": "object",
  "required": ["schemaVersion", "menubar"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "menubar": {
      "type": "object",
      "required": ["height", "screens"],
      "properties": {
        "height": { "type": "integer", "minimum": 28, "maximum": 72 },
        "padding": { "type": "integer", "minimum": 0, "maximum": 24 },
        "spacing": { "type": "integer", "minimum": 0, "maximum": 24 },
        "screens": {
          "type": "object",
          "required": ["default"],
          "additionalProperties": { "$ref": "#/$defs/screenLayout" }
        }
      }
    }
  },
  "$defs": {
    "screenLayout": {
      "type": "object",
      "required": ["slots"],
      "properties": {
        "slots": {
          "type": "object",
          "properties": {
            "start": { "type": "array", "items": { "$ref": "#/$defs/node" } },
            "center": { "type": "array", "items": { "$ref": "#/$defs/node" } },
            "end": { "type": "array", "items": { "$ref": "#/$defs/node" } }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["widget", "group", "panel", "tabs", "spacer"] },
        "widgetType": { "type": "string" },
        "props": { "type": "object" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "child": { "$ref": "#/$defs/node" },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "child"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "labelKey": { "type": "string" },
              "child": { "$ref": "#/$defs/node" }
            }
          }
        }
      }
    }
  }
}
