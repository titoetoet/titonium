{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titonium.theme/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "nameKey", "immutable", "modes", "typography", "metrics", "motion", "material"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "nameKey": { "type": "string", "minLength": 1 },
    "descriptionKey": { "type": "string" },
    "immutable": { "type": "boolean" },
    "modes": {
      "type": "object",
      "required": ["dark", "light"]
    },
    "typography": { "type": "object" },
    "metrics": { "type": "object" },
    "motion": { "type": "object" },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultBackend", "allowedBackends", "compositorIntegration", "opacity"],
      "properties": {
        "defaultBackend": { "enum": ["solid", "qml", "native"] },
        "allowedBackends": { "type": "array", "minItems": 1, "items": { "enum": ["solid", "qml", "native"] } },
        "compositorIntegration": { "type": "boolean" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
