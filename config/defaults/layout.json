{
  "$schema": "titonium.layout/v1",
  "schemaVersion": 1,
  "menubar": {
    "height": 40,
    "padding": 8,
    "spacing": 8,
    "screens": {
      "default": {
        "slots": {
          "start": [
            {
              "id": "menubar-launcher",
              "type": "widget",
              "widgetType": "menubar.launcher",
              "props": {}
            },
            {
              "id": "menubar-window-context",
              "type": "group",
              "padding": 0,
              "spacing": 0,
              "surface": false,
              "children": [
                {
                  "id": "menubar-workspaces",
                  "type": "widget",
                  "widgetType": "menubar.workspaces",
                  "props": {
                    "count": 5
                  }
                },
                {
                  "id": "menubar-active-window",
                  "type": "widget",
                  "widgetType": "menubar.active-window",
                  "props": {
                    "maximumWidth": 560,
                    "activeMaximumWidth": 240
                  }
                }
              ]
            }
          ],
          "center": [],
          "end": [
            {
              "id": "menubar-input-method",
              "type": "widget",
              "widgetType": "menubar.input-method",
              "props": {}
            },
            {
              "id": "menubar-clock",
              "type": "widget",
              "widgetType": "menubar.clock",
              "props": {
                "use24Hour": true
              }
            }
          ]
        }
      },
      "DP-1": {
        "slots": {
          "center": []
        }
      }
    }
  }
}
