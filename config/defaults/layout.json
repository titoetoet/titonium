{
  "$schema": "titonium.layout/v1",
  "schemaVersion": 1,
  "menubar": {
    "height": 40,
    "screens": {
      "default": {
        "slots": {
          "start": [
            {
              "id": "menubar-workspaces",
              "type": "widget",
              "widgetType": "menubar.workspaces",
              "props": {
                "count": 5
              }
            }
          ],
          "center": [
            {
              "id": "menubar-active-window",
              "type": "widget",
              "widgetType": "menubar.active-window",
              "props": {
                "maximumWidth": 280
              }
            }
          ],
          "end": [
            {
              "id": "menubar-input-method",
              "type": "widget",
              "widgetType": "menubar.input-method",
              "props": {}
            },
            {
              "id": "menubar-clock",
              "type": "widget",
              "widgetType": "menubar.clock",
              "props": {
                "use24Hour": true
              }
            }
          ]
        }
      },
      "DP-1": {
        "slots": {
          "center": [
            {
              "id": "dp1-active-window",
              "type": "widget",
              "widgetType": "menubar.active-window",
              "props": {
                "maximumWidth": 320
              }
            }
          ]
        }
      }
    }
  }
}
