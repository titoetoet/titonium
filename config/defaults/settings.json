{
  "$schema": "titonium.settings/v5",
  "schemaVersion": 5,
  "locale": "vi",
  "appearance": {
    "themeId": "titonium-neutral",
    "mode": "dark",
    "density": "comfortable",
    "overrides": {}
  },
  "accessibility": {
    "reducedMotion": false
  },
  "applications": {
    "hiddenIds": []
  },
  "modules": {
    "frame": {
      "enabled": false,
      "thickness": 2,
      "cornerRadius": 12,
      "opacity": 0.85
    },
    "audio": {
      "volumeStep": 5,
      "maxVolume": 100,
      "visualizerEnabled": false,
      "visualizerStyle": "bars",
      "visualizerBars": 32
    },
    "spotlight": {
      "pageTransition": "slide-fade",
      "transitionDuration": 220
    },
    "clock": {
      "use24Hour": true,
      "showLunar": true
    }
  }
}
