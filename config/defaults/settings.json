{
  "$schema": "titonium.settings/v7",
  "schemaVersion": 7,
  "locale": "vi",
  "appearance": { "mode": "dark" },
  "accessibility": { "reducedMotion": false },
  "applications": { "hiddenIds": [] },
  "modules": {
    "spotlight": {
      "pageTransition": "slide-fade",
      "transitionDuration": 220
    },
    "bar": {
      "workspaceCount": 5,
      "autoHide": false,
      "mascotEnabled": true,
      "style": "connected"
    },
    "dock": {
      "visibilityMode": "auto-hide",
      "pinnedIds": []
    },
    "notifications": {
      "toastsEnabled": true,
      "toastDuration": 5000
    },
    "clock": { "use24Hour": true },
    "audio": { "allowAmplification": false }
  }
}
