{
  "$schema": "titonium.theme/v1",
  "schemaVersion": 1,
  "id": "titonium-foundation",
  "name": "Titonium Foundation",
  "modes": {
    "dark": {
      "colors": {
        "background": "#111318",
        "surface": "#20242c",
        "surfaceElevated": "#292e38",
        "textPrimary": "#f5f7fa",
        "textSecondary": "#aeb7c4",
        "border": "#3a4250",
        "accent": "#78a9ff",
        "success": "#66d9a8",
        "warning": "#ffca6a",
        "danger": "#ff7b86"
      }
    },
    "light": {
      "colors": {
        "background": "#eef1f5",
        "surface": "#f8fafc",
        "surfaceElevated": "#ffffff",
        "textPrimary": "#1d2430",
        "textSecondary": "#5f6b7a",
        "border": "#d3d9e2",
        "accent": "#1769e0",
        "success": "#16825d",
        "warning": "#a76000",
        "danger": "#c43145"
      }
    }
  },
  "typography": {
    "fontFamily": "SF Pro Display",
    "fallbackFamily": "Noto Sans",
    "monoFamily": "JetBrains Mono",
    "bodySize": 13,
    "captionSize": 11,
    "titleSize": 16
  },
  "metrics": {
    "barHeight": 40,
    "barPadding": 8,
    "widgetHeight": 28,
    "spacing": 6,
    "radiusSmall": 7,
    "radiusMedium": 12,
    "radiusLarge": 20
  },
  "motion": {
    "fast": 120,
    "normal": 180,
    "slow": 260
  },
  "materials": {
    "qml": {
      "opacity": 0.92,
      "tintStrength": 0.08
    },
    "native": {
      "maskOpacity": 0.08,
      "preset": "subtle"
    }
  }
}

