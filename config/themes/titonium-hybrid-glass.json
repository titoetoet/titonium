{
  "$schema": "titonium.theme/v2",
  "schemaVersion": 2,
  "id": "titonium-hybrid-glass",
  "version": "1.0.0",
  "nameKey": "theme.hybrid.name",
  "descriptionKey": "theme.hybrid.description",
  "immutable": false,
  "modes": {
    "dark": {
      "colors": {
        "background": "#0b1018",
        "surface": "#172131",
        "surfaceElevated": "#202d41",
        "surfaceInteractive": "#2a3a52",
        "textPrimary": "#f2f7ff",
        "textSecondary": "#b3c0d2",
        "textDisabled": "#738197",
        "border": "#526781",
        "borderStrong": "#7890ad",
        "accent": "#73a9ff",
        "accentText": "#07101e",
        "focus": "#a5c8ff",
        "success": "#4bd5a0",
        "warning": "#f1bd5a",
        "danger": "#ff7785"
      }
    },
    "light": {
      "colors": {
        "background": "#dce7f3",
        "surface": "#f5f9ff",
        "surfaceElevated": "#ffffff",
        "surfaceInteractive": "#e6eff9",
        "textPrimary": "#162031",
        "textSecondary": "#526177",
        "textDisabled": "#8793a4",
        "border": "#9fb0c5",
        "borderStrong": "#758aa4",
        "accent": "#216bd2",
        "accentText": "#ffffff",
        "focus": "#175dbd",
        "success": "#14815e",
        "warning": "#9c6200",
        "danger": "#c63249"
      }
    }
  },
  "typography": {
    "fontFamily": "SF Pro Display",
    "fallbackFamily": "Noto Sans",
    "monoFamily": "JetBrains Mono",
    "iconFamily": "Material Symbols Rounded",
    "microSize": 10,
    "bodySize": 13,
    "bodySmallSize": 12,
    "bodyLargeSize": 14,
    "captionSize": 11,
    "labelSize": 13,
    "titleSmallSize": 15,
    "titleSize": 16,
    "titleLargeSize": 20,
    "displaySize": 28,
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "metrics": {
    "grid": 4,
    "barHeight": 40,
    "barPadding": 8,
    "controlHeightSmall": 28,
    "controlHeight": 32,
    "spacingXSmall": 4,
    "spacingSmall": 8,
    "spacingMedium": 12,
    "spacingLarge": 16,
    "radiusSmall": 6,
    "radiusMedium": 10,
    "radiusLarge": 14,
    "borderWidth": 1
  },
  "motion": { "fast": 100, "normal": 160, "slow": 220 },
  "material": {
    "defaultBackend": "auto",
    "allowedBackends": ["native", "qml", "solid"],
    "compositorIntegration": true,
    "opacity": 0.82,
    "tintOpacity": 0.78,
    "borderOpacity": 0.72,
    "specularOpacity": 0.22
  }
}
